{
  "name": "bakery-app",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently \"npm:dev --workspace client\" \"npm:dev --workspace server\"",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server start"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
